{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>Siroshun09/renovate-config//github-actions/renovate.json5',
  ],
  mise: {
    // bootstrap.sh が /etc/mise/config.toml に置く、グローバルの言語ツール
    managerFilePatterns: [
      '/^envs/debian-pc/system/mise/config\\.toml$/',
    ],
  },
  customManagers: [
    {
      description: 'ワークフローの env で固定しているツール（直前の "# renovate:" コメントで対象を指定し、*_SHA256 があれば一緒に更新）',
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/.+\\.ya?ml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+_VERSION: (?<currentValue>\\S+)(?:\\s+\\w+_SHA256: (?<currentDigest>[0-9a-f]{64}))?',
      ],
    },
    {
      description: 'ISO のベースにする Debian netinst ISO',
      customType: 'regex',
      managerFilePatterns: [
        '/^envs/debian-pc/iso\\.conf$/',
      ],
      matchStrings: [
        'DEBIAN_ISO_VERSION=(?<currentValue>\\S+)\\nDEBIAN_ISO_SHA256=(?<currentDigest>[0-9a-f]{64})',
      ],
      depNameTemplate: 'debian-netinst',
      datasourceTemplate: 'custom.debian-netinst',
      versioningTemplate: 'semver-coerced',
    },
    {
      description: 'bootstrap.sh がダウンロードするツール（直前の "# renovate:" コメントで対象を指定し、*_INTEGRITY か *_SHA256 も一緒に更新）',
      customType: 'regex',
      managerFilePatterns: [
        '/^envs/debian-pc/tools\\.conf$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\w+_VERSION=(?<currentValue>\\S+)\\n\\w+_SHA256=(?<currentDigest>[0-9a-f]{64})',
      ],
      versioningTemplate: 'semver',
    },
    {
      description: 'dashboard.html が jsDelivr から読み込む uPlot（integrity は更新できないので、CI が表示する値で直す）',
      customType: 'regex',
      managerFilePatterns: [
        '/^envs/debian-pc/dashboard\\.html$/',
      ],
      matchStrings: [
        'cdn\\.jsdelivr\\.net/npm/(?<depName>uplot)@(?<currentValue>[0-9][0-9.]*)/',
      ],
      datasourceTemplate: 'npm',
    },
  ],
  customDatasources: {
    'debian-netinst': {
      // 最新のポイントリリースの SHA256SUMS から、バージョンとハッシュを取り出す
      defaultRegistryUrlTemplate: 'https://cdimage.debian.org/debian-cd/current/amd64/iso-cd/SHA256SUMS',
      format: 'plain',
      transformTemplates: [
        '{"releases": [releases[$contains(version, /  debian-[0-9.]+-amd64-netinst\\.iso$/)].{"version": $match(version, /debian-([0-9.]+)-amd64/).groups[0], "digest": $substringBefore(version, " ")}]}',
      ],
    },
    'llama-cpp-cuda': {
      // GitHub のリリースの一覧から、CUDA 13.5 版の添付ファイルの SHA256（digest）を取り出す。添付がまだ無いリリースは除く
      defaultRegistryUrlTemplate: 'https://api.github.com/repos/ggml-org/llama.cpp/releases?per_page=100',
      format: 'json',
      transformTemplates: [
        '{"releases": [$map($, function($r) { {"version": $r.tag_name, "releaseTimestamp": $r.published_at, "digest": $substringAfter($r.assets[name = "llama-" & $r.tag_name & "-bin-ubuntu-cuda-13.5-x64.tar.gz"].digest, "sha256:")} })[digest]]}',
      ],
    },
    'node-exporter': {
      // GitHub のリリースの一覧から、linux-amd64 版の SHA256（digest）を取り出す。digest が無いリリースは除く
      defaultRegistryUrlTemplate: 'https://api.github.com/repos/prometheus/node_exporter/releases?per_page=100',
      format: 'json',
      transformTemplates: [
        '{"releases": [$map($[prerelease = false], function($r) { {"version": $r.tag_name, "releaseTimestamp": $r.published_at, "digest": $substringAfter($r.assets[name = "node_exporter-" & $substringAfter($r.tag_name, "v") & ".linux-amd64.tar.gz" and $type(digest) = "string"].digest, "sha256:")} })[digest]]}',
      ],
    },
    victoriametrics: {
      // 同上（オープンソース版の linux-amd64 版。同じリポジトリの過去の VictoriaLogs などのリリースは添付ファイルの名前で除く）
      defaultRegistryUrlTemplate: 'https://api.github.com/repos/VictoriaMetrics/VictoriaMetrics/releases?per_page=100',
      format: 'json',
      transformTemplates: [
        '{"releases": [$map($[prerelease = false], function($r) { {"version": $r.tag_name, "releaseTimestamp": $r.published_at, "digest": $substringAfter($r.assets[name = "victoria-metrics-linux-amd64-" & $r.tag_name & ".tar.gz" and $type(digest) = "string"].digest, "sha256:")} })[digest]]}',
      ],
    },
    victorialogs: {
      // 同上
      defaultRegistryUrlTemplate: 'https://api.github.com/repos/VictoriaMetrics/VictoriaLogs/releases?per_page=100',
      format: 'json',
      transformTemplates: [
        '{"releases": [$map($[prerelease = false], function($r) { {"version": $r.tag_name, "releaseTimestamp": $r.published_at, "digest": $substringAfter($r.assets[name = "victoria-logs-linux-amd64-" & $r.tag_name & ".tar.gz" and $type(digest) = "string"].digest, "sha256:")} })[digest]]}',
      ],
    },
    ttyd: {
      // GitHub のリリースの一覧から、静的リンク版（ttyd.x86_64）の SHA256（digest）を取り出す。digest が無いリリースは除く
      defaultRegistryUrlTemplate: 'https://api.github.com/repos/tsl0922/ttyd/releases?per_page=100',
      format: 'json',
      transformTemplates: [
        '{"releases": [$map($[prerelease = false], function($r) { {"version": $r.tag_name, "releaseTimestamp": $r.published_at, "digest": $substringAfter($r.assets[name = "ttyd.x86_64" and $type(digest) = "string"].digest, "sha256:")} })[digest]]}',
      ],
    },
  },
  packageRules: [
    {
      description: 'VictoriaMetrics と VictoriaLogs は保存形式に関わるので、自動マージせず人が確認する。出た直後の不具合を避けるため 3 日待ち、週 1 回にまとめる',
      matchDatasources: [
        'custom.victoriametrics',
        'custom.victorialogs',
      ],
      minimumReleaseAge: '3 days',
      automerge: false,
      schedule: [
        '* * * * 1',
      ],
    },
    {
      description: 'llama.cpp は毎日リリースされるので週 1 回にまとめる。バージョンは b<番号>',
      matchDatasources: [
        'custom.llama-cpp-cuda',
      ],
      versioning: 'regex:^b(?<patch>\\d+)$',
      schedule: [
        '* * * * 1',
      ],
    },
    {
      description: 'SHA256SUMS には公開日時が無いので待機期間を設けない。SHA256SUMS の署名は検証していないので、自動マージせず人が確認する',
      matchDatasources: [
        'custom.debian-netinst',
      ],
      minimumReleaseAge: null,
      automerge: false,
    },
  ],
}
