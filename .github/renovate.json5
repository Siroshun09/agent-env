{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>Siroshun09/renovate-config//github-actions/renovate.json5',
  ],
  mise: {
    // bootstrap.sh が /etc/mise/config.toml に置く、グローバルの言語ツール
    managerFilePatterns: [
      '/^envs/debian-pc/system/mise/config\\.toml$/',
    ],
  },
  customManagers: [
    {
      description: 'ワークフローの env で固定しているツール（直前の "# renovate:" コメントで対象を指定し、*_SHA256 があれば一緒に更新）',
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/.+\\.ya?ml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+_VERSION: (?<currentValue>\\S+)(?:\\s+\\w+_SHA256: (?<currentDigest>[0-9a-f]{64}))?',
      ],
    },
    {
      description: 'ISO のベースにする Debian netinst ISO',
      customType: 'regex',
      managerFilePatterns: [
        '/^envs/debian-pc/iso\\.conf$/',
      ],
      matchStrings: [
        'DEBIAN_ISO_VERSION=(?<currentValue>\\S+)\\nDEBIAN_ISO_SHA256=(?<currentDigest>[0-9a-f]{64})',
      ],
      depNameTemplate: 'debian-netinst',
      datasourceTemplate: 'custom.debian-netinst',
      versioningTemplate: 'semver-coerced',
    },
    {
      description: 'bootstrap.sh がダウンロードするツール（直前の "# renovate:" コメントで対象を指定し、*_INTEGRITY か *_SHA256 も一緒に更新）',
      customType: 'regex',
      managerFilePatterns: [
        '/^envs/debian-pc/tools\\.conf$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\w+_VERSION=(?<currentValue>\\S+)\\n\\w+_INTEGRITY=(?<currentDigest>sha512-[A-Za-z0-9+/=]+)',
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\w+_VERSION=(?<currentValue>\\S+)\\n\\w+_SHA256=(?<currentDigest>[0-9a-f]{64})',
      ],
      versioningTemplate: 'semver',
    },
  ],
  customDatasources: {
    'debian-netinst': {
      // 最新のポイントリリースの SHA256SUMS から、バージョンとハッシュを取り出す
      defaultRegistryUrlTemplate: 'https://cdimage.debian.org/debian-cd/current/amd64/iso-cd/SHA256SUMS',
      format: 'plain',
      transformTemplates: [
        '{"releases": [releases[$contains(version, /  debian-[0-9.]+-amd64-netinst\\.iso$/)].{"version": $match(version, /debian-([0-9.]+)-amd64/).groups[0], "digest": $substringBefore(version, " ")}]}',
      ],
    },
    'llama-cpp-cuda': {
      // GitHub のリリースの一覧から、CUDA 13.5 版の添付ファイルの SHA256（digest）を取り出す。添付がまだ無いリリースは除く
      defaultRegistryUrlTemplate: 'https://api.github.com/repos/ggml-org/llama.cpp/releases?per_page=100',
      format: 'json',
      transformTemplates: [
        '{"releases": [$map($, function($r) { {"version": $r.tag_name, "releaseTimestamp": $r.published_at, "digest": $substringAfter($r.assets[name = "llama-" & $r.tag_name & "-bin-ubuntu-cuda-13.5-x64.tar.gz"].digest, "sha256:")} })[digest]]}',
      ],
    },
    'npm-integrity': {
      // npm のパッケージ情報から、各バージョンの公開日時と integrity（SHA-512）を取り出す
      defaultRegistryUrlTemplate: 'https://registry.npmjs.org/{{packageName}}',
      format: 'json',
      transformTemplates: [
        '{"releases": $each(versions, function($v, $k) { {"version": $k, "digest": $v.dist.integrity, "releaseTimestamp": $lookup($$.time, $k)} })}',
      ],
    },
  },
  packageRules: [
    {
      description: 'llama.cpp は毎日リリースされるので週 1 回にまとめる。バージョンは b<番号>',
      matchDatasources: [
        'custom.llama-cpp-cuda',
      ],
      versioning: 'regex:^b(?<patch>\\d+)$',
      schedule: [
        '* * * * 1',
      ],
    },
    {
      description: 'SHA256SUMS には公開日時が無いので待機期間を設けない。SHA256SUMS の署名は検証していないので、自動マージせず人が確認する',
      matchDatasources: [
        'custom.debian-netinst',
      ],
      minimumReleaseAge: null,
      automerge: false,
    },
  ],
}
