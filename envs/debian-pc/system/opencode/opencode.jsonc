// bootstrap.sh が /etc/opencode/ に配置する。手で編集せずリポジトリ側を直すこと。
// システムの設定はユーザー・プロジェクトの設定より優先されるので、agent ユーザーは上書きできない。
{
  "$schema": "https://opencode.ai/config.json",
  // バージョンは agent-env で固定し、Renovate と apply.sh で更新する
  "update": "disable",
  // エージェントへの指示。Claude Code と同じファイルを読む
  "instructions": ["/etc/claude-code/CLAUDE.md"],
  // ローカル LLM（llama.cpp の llama-server。bootstrap.sh が NVIDIA の GPU がある PC でだけ起動する）
  "providers": {
    "llama-cpp": {
      "name": "llama.cpp（ローカル）",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": { "baseURL": "http://127.0.0.1:8080/v1" },
      // モデル名は system/llama-models.ini のセクション名と合わせる（埋め込みのモデルはチャットに使えないので登録しない）
      "models": {
        "qwen3.6-35b-a3b": { "name": "Qwen3.6 35B-A3B（ローカル）", "capabilities": { "input": ["text", "image"] } },
      },
    },
  },
  // 使ってよいモデル提供元だけを許可する（ChatGPT プランでのサインインは openai）
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "openai", "effect": "allow" },
    { "action": "provider.use", "resource": "llama-cpp", "effect": "allow" },
  ],
}
