# OpenCode のサーバー（Web UI と API）。PC 内（127.0.0.1）だけで待ち受け、Mac からは SSH トンネルで接続する。
# パスワードは bootstrap.sh が生成する（/etc/agent-env/opencode-server.env。ユーザー名は opencode）
# 状況確認: journalctl -u agent-env-opencode
[Unit]
Description=OpenCode server (agent)
Wants=network-online.target
After=network-online.target

[Service]
User=agent
WorkingDirectory=/home/agent/work
Environment=PATH=/home/agent/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/agent-env/opencode-server.env
ExecStart=/usr/local/bin/opencode serve --hostname 127.0.0.1 --port 4096
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
