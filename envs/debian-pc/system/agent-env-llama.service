# ローカル LLM のサーバー（llama.cpp の llama-server）。PC 内（127.0.0.1:8080）だけで待ち受ける。
# OpenAI 互換の API（/v1）と、ブラウザ用のチャット画面を提供する。Codex からはモデル提供元 llama-cpp として使う。
# ルーターモードで動かす。モデルの一覧と設定は bootstrap.sh が /etc/agent-env/llama-models.ini に書く（tools.conf から生成）。
# リクエストの "model" で指定されたモデルを、必要になった時点で読み込む。同時に読み込むのは 2 つまで
# （文章のモデルと埋め込みのモデル）。超えるときは、処理中のリクエストが終わってから最も使われていないモデルを外す。
# 状況確認: journalctl -u agent-env-llama
[Unit]
Description=llama.cpp server (local LLM)
After=network-online.target

[Service]
User=llama
# GPU を使えない（ドライバーが読み込まれていない、MOK が未承認など）ときは起動しない。
# llama-server は CPU で動いてしまい、気付かないうちに非常に遅くなるため
ExecStartPre=/usr/bin/nvidia-smi -L
# --fit（既定で有効）が、VRAM に収まるように MoE のエキスパートの置き場所などを自動で調整する
ExecStart=/opt/llama.cpp/current/llama-server --models-preset /etc/agent-env/llama-models.ini --models-max 2 --host 127.0.0.1 --port 8080 --metrics
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
