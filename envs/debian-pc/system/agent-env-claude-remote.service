# Claude Code の Remote Control。claude.ai/code や Claude アプリから、この PC のセッションを操作できるようにする。
# PC から Anthropic へ外向きに接続するだけで、外からの接続を受け付けるポートは開けない。
# Claude にログインする（~/.claude/.credentials.json ができる）と、agent-env-claude-remote.path が起動する。
# 状況確認: journalctl -u agent-env-claude-remote
[Unit]
Description=Claude Code Remote Control (agent)
Wants=network-online.target
After=network-online.target

[Service]
User=agent
WorkingDirectory=/home/agent/work
Environment=PATH=/home/agent/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
# セッションは ~/work で始まる。リポジトリの clone や worktree の作成はエージェントが行う
ExecStart=/usr/bin/claude remote-control --name agent-box --spawn same-dir
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
